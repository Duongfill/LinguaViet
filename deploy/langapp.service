# /etc/systemd/system/langapp.service
[Unit]
Description=LinguaViet - app hoc tieng Anh & tieng Trung
After=network.target

[Service]
Type=simple
User=langapp
WorkingDirectory=/opt/langapp
EnvironmentFile=/etc/langapp.env
ExecStart=/usr/bin/node server/src/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
