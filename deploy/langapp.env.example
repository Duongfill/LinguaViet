# Sao chép thành /etc/langapp.env trên server, sửa giá trị, rồi: sudo chmod 600 /etc/langapp.env
NODE_ENV=production
API_PORT=3101
# Thư mục dữ liệu: chứa langapp.db và vapid.json — nhớ sao lưu thư mục này
DB_PATH=/var/lib/langapp/langapp.db
# Chuỗi bí mật ký phiên đăng nhập. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_DAI
# Email liên hệ gửi kèm thông báo đẩy (bắt buộc theo chuẩn Web Push)
VAPID_SUBJECT=mailto:email-cua-ban@example.com
